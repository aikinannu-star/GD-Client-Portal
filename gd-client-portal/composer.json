{
  "name": "gd-client-portal/gd-client-portal",
  "description": "GD Client Portal WordPress plugin test tooling",
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test:syntax": "find . -name '*.php' -not -path './vendor/*' -print0 | xargs -0 -n1 php -l",
    "test:phpunit": "phpunit -c phpunit.xml.dist"
  }
}
